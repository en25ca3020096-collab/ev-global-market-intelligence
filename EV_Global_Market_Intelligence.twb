  <worksheets>
    <!-- WORKSHEET 1: Sales by Category -->
    <worksheet name='Sales by Category'>
      <table>
        <view>
          <datasources>
            <datasource caption='ev_market_dataset' name='federated.ev_market_data' />
          </datasources>
          <datasource-dependencies datasource='federated.ev_market_data'>
            <column datatype='integer' name='[Annual_Sales_Units]' role='measure' type='quantitative' />
            <column datatype='string' name='[Vehicle_Category]' role='dimension' type='nominal' />
            <column-instance column='[Vehicle_Category]' derivation='None' name='[none:Vehicle_Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Annual_Sales_Units]' derivation='Sum' name='[sum:Annual_Sales_Units:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.ev_market_data].[none:Vehicle_Category:nk]' />
              <text column='[federated.ev_market_data].[sum:Annual_Sales_Units:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.ev_market_data].[none:Vehicle_Category:nk]</rows>
        <cols>[federated.ev_market_data].[sum:Annual_Sales_Units:qk]</cols>
      </table>
      <simple-id uuid='{B14F7184-257A-41A8-8F12-1C305B3A10A1}' />
    </worksheet>

