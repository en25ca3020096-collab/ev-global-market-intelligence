      <aliases enabled='yes' />
      <column datatype='string' name='[Manufacturing_Country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
      <column datatype='integer' name='[Model_Year]' role='dimension' type='ordinal' />
      <column datatype='real' name='[Total_Carbon_Offset_Tons]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Annual_Sales_Units]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Annual_Sales_Units]' />
      </column>
      <column caption='Total Carbon Offset (Mt)' datatype='real' name='[Calculation_Carbon_Mt]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Carbon_Offset_Tons]) / 1000000.0' />
      </column>
      <column caption='Price-to-Range ($/km)' datatype='real' name='[Calculation_Price_to_Range]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Base_Price_USD]) / SUM([Driving_Range_km])' />
      </column>
      <layout dim-ordering='alphabetic' dim-percentage='0.45' measure-ordering='alphabetic' measure-percentage='0.55' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
